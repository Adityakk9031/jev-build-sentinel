{
  "name": "jev-build-sentinel",
  "version": "0.1.0",
  "description": "GitHub Action that intelligently selects the minimum safe amount of CI verification for a pull request.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && ncc build build/index.js -o dist",
    "build:check": "tsc --noEmit",
    "test": "node --test --import tsx 'tests/**/*.test.ts'",
    "package": "ncc build build/index.js -o dist"
  },
  "keywords": [
    "github-action",
    "ci",
    "test-selection",
    "risk-engine"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
